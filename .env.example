# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.
#
# Load into your shell before running any scrape scripts:
#   export $(cat .env | xargs)
# or use direnv / python-dotenv if you prefer.

# TMDB API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Must have YouTube Data API v3 enabled on the project.
YOUTUBE_API_KEY=
